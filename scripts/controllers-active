#!/usr/bin/env bash
mode=${1:-any}

steam_active() {
  local tmp dev f total=0
  tmp=$(mktemp -d) || return 1
  for dev in /dev/input/by-id/usb-Valve_Software_Steam_Controller_Puck_*-if0[2-6]-hidraw; do
    [ -e "$dev" ] || continue
    ( timeout 1 cat "$dev" | wc -c > "$tmp/$(basename "$dev")" ) &
  done
  wait
  for f in "$tmp"/*; do
    [ -f "$f" ] && total=$((total + $(cat "$f")))
  done
  rm -rf "$tmp"
  [ "$total" -gt 0 ]
}

bitdo_active() {
  local d props vendor model
  for d in /dev/hidraw*; do
    props=$(udevadm info -q property -n "$d" 2>/dev/null) || continue
    vendor=$(sed -n 's/^ID_VENDOR_ID=//p' <<<"$props")
    model=$(sed -n 's/^ID_MODEL_ID=//p' <<<"$props")
    [ "$vendor" = "2dc8" ] && [ "$model" != "3109" ] && return 0
  done
  return 1
}

case "$mode" in
  steam)  steam_active ;;
  8bitdo) bitdo_active ;;
  *)      bitdo_active || steam_active ;;
esac