#!/usr/bin/env bash

SCRIPT_PATH=$(dirname "$(readlink -f "$0")")
CONFIG=${STEAM_MACHINE_CONFIG:-/etc/steam-machine/steam-machine.conf}

conf_get() {
    local V
    V=$(sed -n "s/^$1[[:space:]]*=[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*\$/\1/p" "$CONFIG" 2>/dev/null | tail -n1)
    V=${V#[\"\']}; V=${V%[\"\']}
    echo "${V:-$2}"
}

SILENT_NEEDED=$(conf_get STEAM_SILENT_PROBES 5)

log() { logger -t steam-controller-watch "$*" 2>/dev/null || echo "$*" >&2; }

WAS_ACTIVE=0
SILENT=0
while true; do
    if "$SCRIPT_PATH/controllers-active" steam; then
        WAS_ACTIVE=1
        SILENT=0
    elif [ "$WAS_ACTIVE" -eq 1 ]; then
        SILENT=$((SILENT + 1))
        if [ "$SILENT" -ge "$SILENT_NEEDED" ]; then
            WAS_ACTIVE=0
            SILENT=0
            log "Steam Controller silent, checking other controllers"
            if "$SCRIPT_PATH/controllers-active" any; then
                log "another controller is still on, not suspending"
            else
                log "no controllers on, suspending"
                "$SCRIPT_PATH/suspend-with-tv-off"
            fi
        fi
    fi
    sleep 1
done
